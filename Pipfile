[[source]]
url = "https://pypi.python.org/simple"
verify_ssl = true
name = "pypi"

[packages]
requests = "*"
# deepdiff is needed for comparing data structures.  8.0.0 introduced breaking changes, as did 9.0.0,
# so stay on 8.x.  8.6.2 is the floor for CVE-2025-58367 (Delta class pollution) and CVE-2026-33155.
deepdiff = ">=8.6.2,<9"
# uvicorn is a Python library for running ASGI applications
uvicorn = ">=0.28.0"
# urllib3 is not imported directly; it comes in transitively via requests.  Pinned here only as a
# security floor: <2.7.0 is affected by CVE-2025-66418, CVE-2025-66471, CVE-2026-21441 (decompression
# bombs) and CVE-2026-44431 (headers leaked across origins on proxied redirects).
urllib3 = ">=2.7.0"

[dev-packages]
# setuptools is needed for building the package
setuptools=">=72.0.0"
# wheel is needed for building the package
wheel = ">=0.43.0"
# twine is needed for uploading the package to PyPI
twine=">=5.1.1"
# pre-commit is needed for running code quality checks
pre-commit=">=3.7.1"
# autoflake is needed for removing unused imports
autoflake=">=2.3.1"
# mypy is needed for type checking
mypy = ">=1.11.1"
# pytest is needed for running tests
pytest = ">=8.2.2"
# black is needed for formatting code
black = ">=24.4.2"
# aiohttp is needed for making HTTP requests asynchronously
aiohttp = ">=3.10.11"
# pytest-ayncio is needed for running async tests
pytest-asyncio = ">=0.23.8"
# types-requests is needed for type hints for requests
types-requests="*"
# bandit is needed for security checks
bandit = ">=1.8.3"
# ruff is needed for linting.  Capped below 0.13 deliberately: this repo has no pyproject.toml or
# ruff.toml, so ruff's built-in defaults ARE the lint config, and ruff changes its default rule
# selection and formatter stable style across pre-1.0 minor releases.  0.16.8 flagged 503 new errors
# (UP006/I001/FURB105) and reformatted 4 files with no source change.  Lift this cap in a dedicated
# PR that adds an explicit ruff config, not in a security bump.
ruff = ">=0.11.5,<0.13"


# These dependencies are required for pipenv-setup.  They conflict with ones above, so we install these
# only when running pipenv-setup
[pipenvsetup]
# vistr is needed for visualizing the dependency graph
vistir=">=0.6.1, <0.7.0" # https://github.com/Madoshakalaka/pipenv-setup/issues/138
# plete is needed for tab completion
plette = "<1.0.0" # https://github.com/Madoshakalaka/pipenv-setup/issues/138
# pipenv-setup is needed for updating setup.py with the dependencies for anyone installing this package
pipenv-setup = ">=3.2.0"
# setuptools >= 81 has a breaking change that causes pipenv-setup to fail, so we need to pin it to a version <= 80.9.0
setuptools = ">=60.9.3, <=80.9.0"

[requires]
python_version = "3.12"

[pipenv]
allow_prereleases = false
